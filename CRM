  return `<button class="card" data-deal="${esc(id)}" style="--stage:${s.color}">
    <span class="co">${esc(az?.ragioneSociale || "Azienda rimossa")}</span>
    <span class="ti">${esc(t.titolo || "")}</span>
    <span class="meta"><span>${esc(t.venditore || "—")}</span><span>${money}${pct}</span></span>
    <span class="meta"><span>${esc(when)}</span></span>
