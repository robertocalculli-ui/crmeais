<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>CRM Divisione EAIS</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap">
<style>
/* Layout: barra riepilogo in alto, pipeline a 5 colonne per stato, scheda trattativa in pannello laterale */
:root {
  --bg: #f3f4f7;
  --surface: #ffffff;
  --sunk: #e9ebf1;
  --line: #d6dae4;
  --fg: #171b2a;
  --muted: #5d6478;
  --accent: #2f45c9;
  --accent-ink: #ffffff;
  --accent-soft: #e4e8fb;
  --danger: #b4283a;
  --s1: #6b5bd2; --s2: #1f7fa8; --s3: #c27a12; --s4: #6a7183; --s5: #1f8a55;
  --font-ui: "Schibsted Grotesk", "Segoe UI", system-ui, sans-serif;
  --font-num: "JetBrains Mono", ui-monospace, "SFMono-Regular", Menlo, monospace;
  --radius: 8px;
  --shadow: 0 1px 2px rgba(20,26,50,.06), 0 4px 14px rgba(20,26,50,.06);
}
@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) {
  --bg: #11131b; --surface: #1a1d28; --sunk: #0d0f15; --line: #2c3142; --fg: #e8eaf2; --muted: #9aa1b6;
  --accent: #8a9bff; --accent-ink: #0d1030; --accent-soft: #232a52; --danger: #ff7d8c;
  --s1: #a597ff; --s2: #5cc3ea; --s3: #f0b14a; --s4: #a3a9ba; --s5: #5fd497;
  --shadow: 0 1px 2px rgba(0,0,0,.4); color-scheme: dark;
} }
:root[data-theme="dark"] {
  --bg: #11131b; --surface: #1a1d28; --sunk: #0d0f15; --line: #2c3142; --fg: #e8eaf2; --muted: #9aa1b6;
  --accent: #8a9bff; --accent-ink: #0d1030; --accent-soft: #232a52; --danger: #ff7d8c;
  --s1: #a597ff; --s2: #5cc3ea; --s3: #f0b14a; --s4: #a3a9ba; --s5: #5fd497;
  --shadow: 0 1px 2px rgba(0,0,0,.4); color-scheme: dark;
}
* { box-sizing: border-box; }
body { background: var(--bg); color: var(--fg); font-family: var(--font-ui); font-size: 14px; line-height: 1.45; }
button, input, select, textarea { font: inherit; color: inherit; }
.num { font-family: var(--font-num); font-variant-numeric: tabular-nums; }
.wrap { padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); max-width: 1480px; margin: 0 auto; }

header.top { background: var(--surface); border-bottom: 1px solid var(--line); }
header.top .wrap { display: flex; align-items: center; gap: 16px 24px; flex-wrap: wrap; padding-block: 14px; }
.brand { display: flex; flex-direction: column; gap: 0; margin-right: auto; }
.brand b { font-size: 18px; font-weight: 800; letter-spacing: -.01em; }
.brand span { font-size: 11px; text-transform: uppercase; letter-spacing: .09em; color: var(--muted); }
nav.tabs { display: flex; gap: 4px; background: var(--sunk); padding: 3px; border-radius: 10px; }
nav.tabs button { border: 0; background: transparent; padding: 7px 14px; border-radius: 8px; cursor: pointer; font-weight: 600; color: var(--muted); }
nav.tabs button[aria-selected="true"] { background: var(--surface); color: var(--fg); box-shadow: var(--shadow); }
.actions { display: flex; gap: 8px; flex-wrap: wrap; }

.btn { border: 1px solid var(--line); background: var(--surface); padding: 8px 14px; border-radius: var(--radius); cursor: pointer; font-weight: 600; display: inline-flex; align-items: center; gap: 6px; }
.btn:hover { border-color: var(--muted); }
.btn.primary { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
.btn.primary:hover { filter: brightness(1.08); }
.btn.ghost { background: transparent; border-color: transparent; color: var(--muted); }
.btn.danger { color: var(--danger); border-color: transparent; background: transparent; }
.btn:disabled { opacity: .45; cursor: not-allowed; }
:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

.notice { margin-top: 12px; padding: 10px 14px; border-radius: var(--radius); background: var(--accent-soft); color: var(--fg); font-size: 13px; }

.kpis { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; margin-top: 18px; }
.kpi { background: var(--surface); padding: 12px 16px; min-width: 0; }
.kpi .lab { font-size: 11px; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); }
.kpi .val { font-size: 22px; font-weight: 500; margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.kpi .sub { font-size: 12px; color: var(--muted); }
@media (max-width: 760px) { .kpis { grid-template-columns: repeat(2, minmax(0,1fr)); } }

.toolbar { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; margin-top: 18px; }
.field-inline { display: flex; align-items: center; gap: 8px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 0 10px; }
.field-inline input, .field-inline select { border: 0; background: transparent; padding: 8px 0; outline: none; min-width: 0; }
.field-inline label { font-size: 12px; color: var(--muted); }
#q { width: 220px; max-width: 60vw; }

main { padding-block: 0 48px; }

/* Pipeline */
.board-scroll { overflow-x: auto; margin-top: 16px; padding-bottom: 8px; }
.board { display: grid; grid-template-columns: repeat(5, minmax(230px, 1fr)); gap: 12px; min-width: 1180px; }
.col { background: var(--sunk); border-radius: 10px; padding: 10px; display: flex; flex-direction: column; gap: 8px; min-height: 200px; }
.col-head { display: flex; align-items: baseline; gap: 8px; padding: 2px 4px 6px; border-bottom: 2px solid var(--stage); }
.col-head b { font-size: 13px; }
.col-head .count { margin-left: auto; font-size: 12px; color: var(--muted); }
.col-head .sum { font-size: 11px; color: var(--muted); width: 100%; }
.col-head { flex-wrap: wrap; }
.card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 10px 12px; cursor: pointer; text-align: left; width: 100%; display: flex; flex-direction: column; gap: 4px; border-left: 3px solid var(--stage); }
.card:hover { border-color: var(--muted); border-left-color: var(--stage); }
.card .co { font-weight: 700; font-size: 14px; overflow-wrap: anywhere; }
.card .ti { color: var(--muted); font-size: 13px; overflow-wrap: anywhere; }
.card .meta { display: flex; justify-content: space-between; gap: 8px; font-size: 12px; color: var(--muted); margin-top: 4px; flex-wrap: wrap; }
.card .money { color: var(--fg); }
.pct { display: inline-block; padding: 0 6px; border-radius: 99px; background: var(--accent-soft); color: var(--accent); font-size: 11px; font-weight: 600; }
.empty-col { color: var(--muted); font-size: 12px; text-align: center; padding: 18px 6px; border: 1px dashed var(--line); border-radius: var(--radius); }

.empty-state { margin-top: 24px; background: var(--surface); border: 1px dashed var(--line); border-radius: 12px; padding: 32px 24px; display: flex; flex-direction: column; gap: 10px; align-items: flex-start; max-width: 640px; }
.empty-state h2 { margin: 0; font-size: 18px; text-wrap: balance; }
.empty-state p { margin: 0; color: var(--muted); max-width: 60ch; }
.empty-state ol { margin: 0; padding-left: 20px; color: var(--muted); }

/* Aziende */
.table-wrap { overflow-x: auto; margin-top: 16px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); }
table { border-collapse: collapse; width: 100%; min-width: 860px; }
th, td { text-align: left; padding: 10px 14px; border-bottom: 1px solid var(--line); vertical-align: top; }
th { font-size: 11px; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); font-weight: 600; background: var(--sunk); }
tr:last-child td { border-bottom: 0; }
tbody tr { cursor: pointer; }
tbody tr:hover td { background: var(--accent-soft); }
td .small { color: var(--muted); font-size: 12px; }

/* Pannelli */
.overlay { position: fixed; inset: 0; background: rgba(10,12,22,.45); z-index: 40; display: flex; justify-content: flex-end; }
.panel { background: var(--surface); width: min(620px, 100%); height: 100%; overflow-y: auto; display: flex; flex-direction: column; box-shadow: -10px 0 30px rgba(0,0,0,.18);
  padding-top: env(safe-area-inset-top, 0px); padding-bottom: env(safe-area-inset-bottom, 0px); padding-right: env(safe-area-inset-right, 0px); }
.panel-head { display: flex; align-items: flex-start; gap: 12px; padding: 18px 20px 14px; border-bottom: 1px solid var(--line); position: sticky; top: 0; background: var(--surface); z-index: 2; }
.panel-head h2 { margin: 0; font-size: 18px; line-height: 1.25; text-wrap: balance; overflow-wrap: anywhere; }
.panel-head .eyebrow { font-size: 11px; text-transform: uppercase; letter-spacing: .09em; color: var(--muted); }
.panel-head .x { margin-left: auto; flex: none; }
.panel-body { padding: 18px 20px; display: flex; flex-direction: column; gap: 18px; flex: 1; }
.panel-foot { padding: 14px 20px; border-top: 1px solid var(--line); display: flex; gap: 8px; align-items: center; flex-wrap: wrap; position: sticky; bottom: 0; background: var(--surface); }
.panel-foot .spacer { flex: 1; }

.grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.grid2 .full { grid-column: 1 / -1; }
@media (max-width: 520px) { .grid2 { grid-template-columns: 1fr; } }
.f { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
.f label { font-size: 12px; font-weight: 600; color: var(--muted); }
.f input, .f select, .f textarea { border: 1px solid var(--line); background: var(--bg); border-radius: 6px; padding: 8px 10px; width: 100%; }
.f textarea { min-height: 72px; resize: vertical; line-height: 1.45; }
.f input:focus, .f select:focus, .f textarea:focus { outline: none; border-color: var(--accent); }
.req::after { content: " *"; color: var(--danger); }
.err { color: var(--danger); font-size: 13px; }

.section-title { font-size: 11px; text-transform: uppercase; letter-spacing: .09em; color: var(--muted); font-weight: 700; margin: 0; }

.stepper { display: grid; grid-template-columns: repeat(5, minmax(0,1fr)); gap: 4px; }
.step { border: 1px solid var(--line); background: var(--bg); border-radius: 6px; padding: 8px 6px; cursor: pointer; font-size: 12px; font-weight: 600; color: var(--muted); text-align: center; line-height: 1.2; }
.step.done { border-color: var(--stage); color: var(--stage); }
.step.current { background: var(--stage); border-color: var(--stage); color: var(--surface); }
@media (max-width: 520px) { .stepper { grid-template-columns: 1fr; } .step { text-align: left; } }

.stage-block { border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
.stage-block > .sb-head { display: flex; align-items: center; gap: 8px; padding: 8px 12px; background: var(--sunk); border-left: 3px solid var(--stage); }
.stage-block > .sb-head b { font-size: 13px; }
.stage-block > .sb-head .tag { margin-left: auto; font-size: 11px; color: var(--muted); }
.stage-block > .sb-body { padding: 12px; display: flex; flex-direction: column; gap: 12px; }
.stage-block.future { opacity: .72; }
.stage-block.current { border-color: var(--stage); }

.range-row { display: flex; gap: 10px; align-items: center; }
.range-row input[type=range] { flex: 1; accent-color: var(--accent); padding: 0; border: 0; background: transparent; }
.range-row input[type=number] { width: 80px; }
.weighted { font-size: 12px; color: var(--muted); }

.confirm { background: var(--accent-soft); border-radius: var(--radius); padding: 10px 12px; display: flex; gap: 8px; align-items: center; flex-wrap: wrap; font-size: 13px; }

.deals-mini { display: flex; flex-direction: column; gap: 6px; }
.deal-mini { display: flex; gap: 8px; align-items: center; border: 1px solid var(--line); border-left: 3px solid var(--stage); border-radius: 6px; padding: 8px 10px; cursor: pointer; background: var(--bg); text-align: left; width: 100%; }
.deal-mini span:first-child { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.chip { font-size: 11px; font-weight: 600; color: var(--stage); white-space: nowrap; }

.toast { position: fixed; left: 50%; transform: translateX(-50%); bottom: calc(20px + env(safe-area-inset-bottom, 0px)); background: var(--fg); color: var(--bg); padding: 10px 16px; border-radius: 8px; z-index: 60; font-weight: 600; font-size: 13px; }

@media (prefers-reduced-motion: no-preference) {
  .panel { animation: slide .18s ease-out; }
  @keyframes slide { from { transform: translateX(24px); opacity: .6; } to { transform: none; opacity: 1; } }
}
</style>

<header class="top">
  <div class="wrap">
    <div class="brand"><span>Divisione EAIS</span><b>CRM Trattative</b></div>
    <nav class="tabs" role="tablist">
      <button role="tab" id="tab-pipeline" aria-selected="true" data-view="pipeline">Pipeline</button>
      <button role="tab" id="tab-aziende" aria-selected="false" data-view="aziende">Anagrafica aziende</button>
    </nav>
    <div class="actions">
      <button class="btn" id="btn-new-az">+ Nuova azienda</button>
      <button class="btn primary" id="btn-new-deal">+ Nuova trattativa</button>
    </div>
  </div>
</header>

<main class="wrap">
  <div id="notice" class="notice" hidden></div>
  <section id="kpis" class="kpis" aria-label="Riepilogo"></section>

  <section id="view-pipeline">
    <div class="toolbar">
      <div class="field-inline"><label for="q">Cerca</label><input id="q" type="search" placeholder="Azienda, trattativa, nota…"></div>
      <div class="field-inline"><label for="f-vend">Venditore</label><select id="f-vend"><option value="">Tutti</option></select></div>
    </div>
    <div id="pipeline-empty" hidden></div>
    <div class="board-scroll"><div class="board" id="board"></div></div>
  </section>

  <section id="view-aziende" hidden>
    <div class="toolbar">
      <div class="field-inline"><label for="qa">Cerca</label><input id="qa" type="search" placeholder="Ragione sociale, P.IVA, città…"></div>
    </div>
    <div id="aziende-empty" hidden></div>
    <div class="table-wrap" id="aziende-table-wrap">
      <table>
        <thead><tr><th>Ragione sociale</th><th>P.IVA</th><th>Settore</th><th>Città</th><th>Referente</th><th>Contatti</th><th>Trattative</th></tr></thead>
        <tbody id="aziende-body"></tbody>
      </table>
    </div>
  </section>
</main>

<div id="layer"></div>
<div id="toast" class="toast" hidden></div>

<script>
const STAGES = [
  { id: "appuntamento", label: "Fissato appuntamento", color: "var(--s1)" },
  { id: "incontro",     label: "Incontro effettuato",  color: "var(--s2)" },
  { id: "preventivo",   label: "Preventivo inviato",   color: "var(--s3)" },
  { id: "chiusa",       label: "Trattativa chiusa",    color: "var(--s4)" },
  { id: "ordine",       label: "Ordine effettuato",    color: "var(--s5)" },
];
const stageIdx = id => Math.max(0, STAGES.findIndex(s => s.id === id));
const stageOf = id => STAGES[stageIdx(id)];

const state = { aziende: new Map(), trattative: new Map(), view: "pipeline", ready: { a: false, t: false }, canWrite: true, live: false };
let db = null;

const $ = s => document.querySelector(s);
const esc = s => String(s ?? "").replace(/[&<>"']/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
const eur = n => (n == null || n === "" || isNaN(n)) ? "—" : new Intl.NumberFormat("it-IT", { style: "currency", currency: "EUR", maximumFractionDigits: 0 }).format(n);
const fmtDate = iso => { if (!iso) return ""; const d = new Date(iso); return isNaN(d) ? "" : d.toLocaleDateString("it-IT", { day: "2-digit", month: "short", year: "numeric" }); };
const fmtDT = iso => { if (!iso) return ""; const d = new Date(iso); return isNaN(d) ? "" : d.toLocaleString("it-IT", { day: "2-digit", month: "short", hour: "2-digit", minute: "2-digit" }); };
const nowIso = () => new Date().toISOString();
const newId = () => Date.now().toString(36) + Math.random().toString(36).slice(2, 8);
const toNum = v => { if (v === "" || v == null) return null; const n = Number(String(v).replace(/\./g, "").replace(",", ".")); return isNaN(n) ? null : n; };

function toast(msg) { const t = $("#toast"); t.textContent = msg; t.hidden = false; clearTimeout(toast._t); toast._t = setTimeout(() => t.hidden = true, 2200); }

/* ---------- Store ---------- */
async function save(col, id, data) {
  if (db) {
    try { await db.collection(col).doc(id).set(data); }
    catch (e) {
      if (e && e.code === "invalid_argument") { state.canWrite = false; applyWriteState(); throw new Error("Non hai i permessi per modificare i dati di questo CRM."); }
      if (e && e.code === "quota_exceeded") throw new Error("Spazio dati esaurito: elimina record vecchi e riprova.");
      throw new Error("Salvataggio non riuscito. Riprova tra qualche secondo.");
    }
  } else {
    state[col].set(id, data); renderAll();
  }
}
async function remove(col, id) {
  if (db) { await db.collection(col).doc(id).delete(); }
  else { state[col].delete(id); renderAll(); }
}

async function init() {
  renderAll();
  let user = null;
  try { [db, user] = await Promise.all([window.claude?.use?.("db") ?? null, window.claude?.use?.("user") ?? null]); } catch { db = null; }
  if (!db) {
    state.ready = { a: true, t: true };
    const n = $("#notice"); n.hidden = false;
    n.textContent = "Archivio condiviso non raggiungibile in questa vista: puoi provare il CRM, ma i dati inseriti restano solo in questa pagina e si perdono alla chiusura.";
    renderAll(); return;
  }
  state.live = true;
  try { const c = await user?.can?.("data.write"); if (c === false) { state.canWrite = false; } } catch {}
  applyWriteState();
  db.collection("aziende").onSnapshot(snap => {
    state.aziende = new Map(snap.docs.map(d => [d.id, d.data()])); state.ready.a = true; renderAll(); refreshOpenPanel();
  }, () => {});
  db.collection("trattative").onSnapshot(snap => {
    state.trattative = new Map(snap.docs.map(d => [d.id, d.data()])); state.ready.t = true; renderAll(); refreshOpenPanel();
  }, () => {});
}
function applyWriteState() {
  $("#btn-new-az").disabled = !state.canWrite; $("#btn-new-deal").disabled = !state.canWrite;
  if (!state.canWrite) { const n = $("#notice"); n.hidden = false; n.textContent = "Hai accesso in sola lettura: per inserire aziende e aggiornare trattative chiedi al proprietario il ruolo di Contributore."; }
}

/* ---------- Render ---------- */
function filteredDeals() {
  const q = $("#q").value.trim().toLowerCase(); const v = $("#f-vend").value;
  return [...state.trattative.entries()].filter(([id, t]) => {
    if (v && (t.venditore || "") !== v) return false;
    if (!q) return true;
    const az = state.aziende.get(t.aziendaId);
    const hay = [az?.ragioneSociale, t.titolo, t.venditore, ...Object.values(t.note || {})].join(" ").toLowerCase();
    return hay.includes(q);
  });
}

function renderKpis(deals) {
  const open = deals.filter(([, t]) => !["chiusa", "ordine"].includes(t.stato));
  const prev = deals.filter(([, t]) => t.stato === "preventivo");
  const prevVal = prev.reduce((s, [, t]) => s + (Number(t.importo) || 0), 0);
  const weighted = prev.reduce((s, [, t]) => s + (Number(t.importo) || 0) * (Number(t.probabilita) || 0) / 100, 0);
  const ord = deals.filter(([, t]) => t.stato === "ordine");
  const ordVal = ord.reduce((s, [, t]) => s + (Number(t.importo) || 0), 0);
  $("#kpis").innerHTML = `
    <div class="kpi"><div class="lab">Trattative aperte</div><div class="val num">${open.length}</div><div class="sub">${state.aziende.size} aziende in anagrafica</div></div>
    <div class="kpi"><div class="lab">Preventivi inviati</div><div class="val num">${eur(prevVal)}</div><div class="sub">${prev.length} preventivi, importo netto</div></div>
    <div class="kpi"><div class="lab">Valore ponderato</div><div class="val num">${eur(weighted)}</div><div class="sub">importo × % di chiusura</div></div>
    <div class="kpi"><div class="lab">Ordini effettuati</div><div class="val num">${eur(ordVal)}</div><div class="sub">${ord.length} ordini</div></div>`;
}

function renderVendorFilter() {
  const sel = $("#f-vend"); const cur = sel.value;
  const vs = [...new Set([...state.trattative.values()].map(t => t.venditore).filter(Boolean))].sort((a, b) => a.localeCompare(b, "it"));
  sel.innerHTML = `<option value="">Tutti</option>` + vs.map(v => `<option${v === cur ? " selected" : ""}>${esc(v)}</option>`).join("");
}

function renderBoard(deals) {
  const loading = state.live && !(state.ready.a && state.ready.t);
  const emptyBox = $("#pipeline-empty");
  if (!loading && state.trattative.size === 0) {
    emptyBox.hidden = false;
    emptyBox.innerHTML = `<div class="empty-state">
      <h2>Nessuna trattativa ancora</h2>
      <p>Qui comparirà la pipeline della divisione, con una colonna per ogni stato: dall'appuntamento fissato all'ordine.</p>
      <ol><li>${state.aziende.size ? "Hai già " + state.aziende.size + " aziende in anagrafica." : "Inserisci l'azienda cliente in anagrafica."}</li><li>Apri una trattativa e aggiorna lo stato man mano che avanza.</li></ol>
      <div class="actions">${state.aziende.size ? "" : `<button class="btn" data-act="new-az">+ Nuova azienda</button>`}<button class="btn primary" data-act="new-deal" ${state.canWrite ? "" : "disabled"}>+ Nuova trattativa</button></div>
    </div>`;
  } else emptyBox.hidden = true;

  $("#board").innerHTML = STAGES.map(s => {
    const items = deals.filter(([, t]) => (t.stato || "appuntamento") === s.id)
      .sort((a, b) => (b[1].updatedAt || "").localeCompare(a[1].updatedAt || ""));
    const sum = items.reduce((x, [, t]) => x + (Number(t.importo) || 0), 0);
    const showSum = ["preventivo", "chiusa", "ordine"].includes(s.id);
    return `<div class="col" style="--stage:${s.color}">
      <div class="col-head"><b>${s.label}</b><span class="count num">${items.length}</span>${showSum ? `<span class="sum num">${eur(sum)}</span>` : ""}</div>
      ${items.length ? items.map(([id, t]) => cardHtml(id, t, s)).join("") : `<div class="empty-col">${loading ? "Caricamento…" : "Nessuna trattativa"}</div>`}
    </div>`;
  }).join("");
}
function cardHtml(id, t, s) {
  const az = state.aziende.get(t.aziendaId);
  const money = t.importo != null && t.importo !== "" ? `<span class="money num">${eur(t.importo)}</span>` : "";
