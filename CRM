/* Trattativa */
function openDeal(id, keep, presetAz) {
  const isNew = !id;
  const t = id ? structuredClone(state.trattative.get(id)) : { stato: "appuntamento", note: {}, aziendaId: presetAz || "", importo: null, probabilita: null };
  if (!t) return;
  t.note = t.note || {};
  openPanel = { type: "deal", id, dirty: false, stato: t.stato || "appuntamento" };
  const az = state.aziende.get(t.aziendaId);
  const azOpts = [...state.aziende.entries()].sort((a, b) => (a[1].ragioneSociale || "").localeCompare(b[1].ragioneSociale || "", "it"))
    .map(([k, a]) => `<option value="${esc(k)}" ${k === t.aziendaId ? "selected" : ""}>${esc(a.ragioneSociale)}</option>`).join("");
  const vendList = [...new Set([...state.trattative.values()].map(x => x.venditore).filter(Boolean))].map(v => `<option value="${esc(v)}">`).join("");
  const dtVal = t.dataAppuntamento ? toLocalInput(t.dataAppuntamento) : "";

  showPanel(`
    <div class="panel-head"><div><div class="eyebrow">${isNew ? "Nuova trattativa" : esc(az?.ragioneSociale || "Trattativa")}</div><h2>${isNew ? "Apri una trattativa" : esc(t.titolo || "Trattativa")}</h2></div><button class="btn ghost x" data-act="close" aria-label="Chiudi">✕</button></div>
    <form class="panel-body" id="deal-form">
      ${state.aziende.size === 0 ? `<div class="confirm">Per aprire una trattativa serve almeno un'azienda in anagrafica. <button type="button" class="btn" data-act="new-az">+ Nuova azienda</button></div>` : ""}
      <div class="grid2">
        <div class="f full"><label for="d-az" class="req">Azienda cliente</label><select id="d-az"><option value="">Seleziona dall'anagrafica…</option>${azOpts}</select></div>
        <div class="f full"><label for="d-titolo" class="req">Oggetto della trattativa</label><input id="d-titolo" value="${esc(t.titolo)}" placeholder="es. Fornitura assistente virtuale sportello clienti"></div>
        <div class="f"><label for="d-vend" class="req">Venditore</label><input id="d-vend" list="vend-list" value="${esc(t.venditore)}" placeholder="Nome e cognome"><datalist id="vend-list">${vendList}</datalist></div>
      </div>

      <p class="section-title">Stato della trattativa</p>
      <div class="stepper" id="stepper"></div>

      <div id="stage-blocks" style="display:flex;flex-direction:column;gap:12px"></div>
      ${!isNew && t.storico?.length ? `<p class="section-title">Storico stati</p><div class="small" style="color:var(--muted);display:flex;flex-direction:column;gap:2px">${t.storico.slice().reverse().map(h => `<span>${esc(fmtDT(h.at))} — ${esc(stageOf(h.stato).label)}</span>`).join("")}</div>` : ""}
      <div class="err" id="d-err" hidden></div>
      <div id="del-confirm"></div>
    </form>
    <div class="panel-foot">
      ${!isNew ? `<button class="btn danger" data-act="del-deal" ${state.canWrite ? "" : "disabled"}>Elimina</button>` : ""}
      <span class="spacer"></span>
      <button class="btn ghost" data-act="close">Annulla</button>
      <button class="btn primary" data-act="save-deal" ${state.canWrite ? "" : "disabled"}>${isNew ? "Crea trattativa" : "Salva"}</button>
    </div>`);

  openPanel.draft = t; openPanel.dtVal = dtVal;
  drawStages();
  const form = $("#deal-form");
  form.addEventListener("input", markDirty);
  form.addEventListener("submit", e => { e.preventDefault(); saveDeal(); });
  if (!state.canWrite) form.querySelectorAll("input,select,textarea").forEach(el => el.disabled = true);
}
function toLocalInput(iso) { const d = new Date(iso); if (isNaN(d)) return ""; const p = n => String(n).padStart(2, "0"); return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}T${p(d.getHours())}:${p(d.getMinutes())}`; }

function captureStageInputs() {
  const t = openPanel.draft;
  STAGES.forEach(s => { const el = $("#n-" + s.id); if (el) t.note[s.id] = el.value; });
  const imp = $("#d-imp"); if (imp) t.importo = toNum(imp.value);
  const pr = $("#d-prob-n"); if (pr) t.probabilita = pr.value === "" ? null : Math.min(100, Math.max(0, Number(pr.value)));
  const dt = $("#d-dt"); if (dt) openPanel.dtVal = dt.value;
}
function drawStages() {
  const t = openPanel.draft; const cur = stageIdx(openPanel.stato);
  $("#stepper").innerHTML = STAGES.map((s, i) => `<button type="button" class="step ${i < cur ? "done" : ""} ${i === cur ? "current" : ""}" style="--stage:${s.color}" data-stage="${s.id}" aria-pressed="${i === cur}">${s.label}</button>`).join("");
  $("#stage-blocks").innerHTML = STAGES.map((s, i) => {
    const cls = i === cur ? "current" : i > cur ? "future" : "";
    const tag = i === cur ? "stato attuale" : i < cur ? "completato" : "da raggiungere";
    let extra = "";
    if (s.id === "appuntamento") extra = `<div class="f"><label for="d-dt">Data e ora appuntamento</label><input id="d-dt" type="datetime-local" value="${esc(openPanel.dtVal)}"></div>`;
    if (s.id === "preventivo") {
      const p = t.probabilita ?? "";
      extra = `<div class="grid2">
        <div class="f"><label for="d-imp" class="${i <= cur ? "req" : ""}">Importo del deal netto (€)</label><input id="d-imp" inputmode="decimal" class="num" value="${t.importo ?? ""}" placeholder="es. 18500"></div>
        <div class="f"><label for="d-prob-n" class="${i <= cur ? "req" : ""}">% di chiusura</label>
          <div class="range-row"><input id="d-prob-r" type="range" min="0" max="100" step="5" value="${p === "" ? 50 : p}" aria-label="% di chiusura"><input id="d-prob-n" type="number" min="0" max="100" class="num" value="${p}" placeholder="%"></div></div>
        <div class="weighted full" id="d-weighted">${weightedText(t.importo, t.probabilita)}</div>
      </div>`;
    }
    return `<div class="stage-block ${cls}" style="--stage:${s.color}">
      <div class="sb-head"><b>${s.label}</b><span class="tag">${tag}</span></div>
      <div class="sb-body">${extra}
        <div class="f"><label for="n-${s.id}">Note del venditore</label><textarea id="n-${s.id}" placeholder="${notePh(s.id)}">${esc(t.note[s.id] || "")}</textarea></div>
      </div></div>`;
  }).join("");
  const r = $("#d-prob-r"), n = $("#d-prob-n"), imp = $("#d-imp");
  const upd = () => { $("#d-weighted").textContent = weightedText(toNum(imp.value), n.value === "" ? null : Number(n.value)); };
  r?.addEventListener("input", () => { n.value = r.value; upd(); markDirty(); });
  n?.addEventListener("input", () => { if (n.value !== "") r.value = n.value; upd(); });
  imp?.addEventListener("input", upd);
  if (!state.canWrite) $("#stage-blocks").querySelectorAll("input,textarea").forEach(el => el.disabled = true);
}
function weightedText(imp, p) { return imp != null && p != null && !isNaN(p) ? `Valore ponderato: ${eur(imp * p / 100)}` : "Il valore ponderato si calcola con importo e % di chiusura."; }
function notePh(id) { return ({ appuntamento: "Chi incontrare, dove, esigenza emersa al telefono…", incontro: "Esito dell'incontro, interlocutori presenti, bisogni rilevati…", preventivo: "Contenuto dell'offerta, condizioni, scadenza, obiezioni…", chiusa: "Esito della trattativa, motivazioni, accordi presi…", ordine: "Numero ordine, data firma, tempi di avvio, fatturazione…" })[id]; }

async function saveDeal() {
  captureStageInputs();
  const t = openPanel.draft; const err = $("#d-err");
  const fail = (m, el) => { err.hidden = false; err.textContent = m; el && $(el)?.focus(); };
  t.aziendaId = $("#d-az").value; t.titolo = $("#d-titolo").value.trim(); t.venditore = $("#d-vend").value.trim();
  if (!t.aziendaId) return fail("Seleziona l'azienda cliente dall'anagrafica.", "#d-az");
  if (!t.titolo) return fail("Indica l'oggetto della trattativa.", "#d-titolo");
  if (!t.venditore) return fail("Indica il venditore che segue la trattativa.", "#d-vend");
  const st = openPanel.stato;
  if (stageIdx(st) >= stageIdx("preventivo")) {
    if (t.importo == null || t.importo < 0) return fail("Dallo stato «Preventivo inviato» in poi serve l'importo netto del deal.", "#d-imp");
    if (st === "preventivo" && (t.probabilita == null || isNaN(t.probabilita))) return fail("Inserisci la % di chiusura del preventivo.", "#d-prob-n");
  }
  t.dataAppuntamento = openPanel.dtVal ? new Date(openPanel.dtVal).toISOString() : null;
  const id = openPanel.id || newId();
  const prev = openPanel.id ? state.trattative.get(openPanel.id) : null;
  t.storico = Array.isArray(prev?.storico) ? prev.storico.slice(-40) : [];
  if (!prev || prev.stato !== st) t.storico.push({ stato: st, at: nowIso() });
  t.stato = st; t.createdAt = prev?.createdAt || nowIso(); t.updatedAt = nowIso();
  const data = JSON.parse(JSON.stringify(t));
  try { await save("trattative", id, data); toast(prev ? "Trattativa salvata" : "Trattativa creata"); closePanel(); }
  catch (e) { fail(e.message); }
}

/* ---------- Eventi ---------- */
document.addEventListener("click", async e => {
  const el = e.target.closest("[data-act],[data-deal],[data-az],[data-view],[data-stage]"); if (!el) return;
  if (el.dataset.view) { setView(el.dataset.view); return; }
  if (el.dataset.stage) { if (!state.canWrite) return; captureStageInputs(); openPanel.stato = el.dataset.stage; openPanel.dirty = true; drawStages(); return; }
  if (el.dataset.deal) { openDeal(el.dataset.deal); return; }
  if (el.dataset.az) { openAziendaView(el.dataset.az); return; }
  const act = el.dataset.act;
  if (act === "close") closePanel();
  if (act === "new-az") openAziendaForm();
  if (act === "new-deal") openDeal(null);
  if (act === "edit-az") openAziendaForm(openPanel.id);
  if (act === "new-deal-az") openDeal(null, false, openPanel.id);
  if (act === "save-az") saveAzienda();
  if (act === "save-deal") saveDeal();
  if (act === "del-deal") {
    $("#del-confirm").innerHTML = `<div class="confirm">Eliminare definitivamente questa trattativa e le sue note? <button type="button" class="btn danger" data-act="del-deal-yes">Sì, elimina</button><button type="button" class="btn ghost" data-act="del-no">Annulla</button></div>`;
    $("#del-confirm").scrollIntoView({ block: "nearest" });
  }
  if (act === "del-deal-yes") { try { await remove("trattative", openPanel.id); toast("Trattativa eliminata"); closePanel(); } catch { $("#d-err").hidden = false; $("#d-err").textContent = "Eliminazione non riuscita. Riprova."; } }
  if (act === "del-az") {
    const n = [...state.trattative.values()].filter(t => t.aziendaId === openPanel.id).length;
    const err = $("#az-err"); err.hidden = false;
    if (n) { err.textContent = `Non puoi eliminare un'azienda con ${n} trattativ${n === 1 ? "a" : "e"} collegat${n === 1 ? "a" : "e"}: elimina prima le trattative.`; return; }
    err.innerHTML = `<div class="confirm">Eliminare definitivamente questa azienda? <button type="button" class="btn danger" data-act="del-az-yes">Sì, elimina</button><button type="button" class="btn ghost" data-act="del-no">Annulla</button></div>`;
  }
  if (act === "del-az-yes") { try { await remove("aziende", openPanel.id); toast("Azienda eliminata"); closePanel(); } catch { toast("Eliminazione non riuscita"); } }
  if (act === "del-no") { const c = $("#del-confirm"); if (c) c.innerHTML = ""; const a = $("#az-err"); if (a) a.hidden = true; }
});
document.addEventListener("keydown", e => { if (e.key === "Escape" && openPanel) closePanel(); });
$("#btn-new-az").addEventListener("click", () => openAziendaForm());
$("#btn-new-deal").addEventListener("click", () => openDeal(null));
$("#q").addEventListener("input", renderAll);
$("#f-vend").addEventListener("change", renderAll);
$("#qa").addEventListener("input", renderAziende);

function setView(v) {
  state.view = v;
  document.querySelectorAll("nav.tabs button").forEach(b => b.setAttribute("aria-selected", b.dataset.view === v));
  $("#view-pipeline").hidden = v !== "pipeline"; $("#view-aziende").hidden = v !== "aziende";
  try { localStorage.setItem("crm-eais-view", v); } catch {}
}
(function () {
  let v = null;
  if (location.hash === "#aziende" || location.hash === "#pipeline") v = location.hash.slice(1);
  if (!v) { try { v = localStorage.getItem("crm-eais-view"); } catch {} }
  setView(v === "aziende" ? "aziende" : "pipeline");
})();

init();
</script>

