async function saveAzienda() {
  const id = openPanel.id || newId();
  const keys = ["ragioneSociale", "piva", "codiceFiscale", "settore", "pec", "indirizzo", "citta", "provincia", "referente", "ruolo", "telefono", "email", "note"];
  const prev = openPanel.id ? state.aziende.get(openPanel.id) : null;
  const data = Object.fromEntries(keys.map(k => [k, ($("#az-" + k).value || "").trim()]));
  data.provincia = data.provincia.toUpperCase();
  const err = $("#az-err");
  if (!data.ragioneSociale) { err.hidden = false; err.textContent = "Inserisci la ragione sociale."; $("#az-ragioneSociale").focus(); return; }
  if (data.piva && !/^(IT)?\d{11}$/i.test(data.piva.replace(/\s/g, ""))) { err.hidden = false; err.textContent = "La partita IVA italiana ha 11 cifre. Controlla il numero inserito."; $("#az-piva").focus(); return; }
  const dup = data.piva && [...state.aziende.entries()].find(([k, a]) => k !== id && a.piva && a.piva.replace(/\D/g, "") === data.piva.replace(/\D/g, ""));
  if (dup) { err.hidden = false; err.textContent = `Questa partita IVA è già registrata per ${dup[1].ragioneSociale}.`; return; }
  data.createdAt = prev?.createdAt || nowIso(); data.updatedAt = nowIso();
  try { await save("aziende", id, data); toast(openPanel?.id ? "Azienda aggiornata" : "Azienda inserita"); openAziendaView(id); }
  catch (e) { err.hidden = false; err.textContent = e.message; }
}

