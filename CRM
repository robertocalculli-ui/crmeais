  $("#ov").addEventListener("mousedown", e => { if (e.target.id === "ov") closePanel(); });
  const first = $("#layer").querySelector("input, select, textarea"); first?.focus({ preventScroll: true });
}
function refreshOpenPanel() {
  // Se un altro venditore modifica il record aperto e qui non ci sono modifiche in corso, aggiorna la vista
  if (!openPanel || openPanel.dirty) return;
  if (openPanel.type === "deal" && openPanel.id && state.trattative.has(openPanel.id)) openDeal(openPanel.id, true);
